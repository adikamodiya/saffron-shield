{
  "datasets": [
    {
      "name": "claims_ops_metrics",
      "displayName": "Claims Ops Metrics",
      "config": {
        "source": "claims.analytics.mv_claims",
        "measures": [
          {
            "name": "claim_count",
            "expr": "MEASURE(source.claim_count)"
          },
          {
            "name": "total_approved_amount",
            "expr": "MEASURE(source.approved_amount)"
          },
          {
            "name": "rejection_rate",
            "expr": "MEASURE(source.rejection_rate)"
          },
          {
            "name": "avg_turnaround_days",
            "expr": "MEASURE(source.avg_turnaround_days)"
          },
          {
            "name": "rejected_count",
            "expr": "MEASURE(source.rejected_count)"
          }
        ],
        "version": "1.1",
        "comment": "Claims Ops dashboard metrics layer. Single source of truth is claims.analytics.mv_claims (R4 certified definitions); this layer only renames fields for the dashboard and adds no formulas of its own.",
        "dimensions": [
          {
            "name": "admission_month",
            "expr": "CAST(source.admission_month AS DATE)"
          },
          {
            "name": "plan_code_at_admission",
            "expr": "source.plan_code"
          },
          {
            "name": "hospital_city_tier",
            "expr": "source.city_tier"
          },
          {
            "name": "hospital_id",
            "expr": "source.hospital_id"
          },
          {
            "name": "hospital_city",
            "expr": "source.hospital_city"
          },
          {
            "name": "claim_type",
            "expr": "source.claim_type"
          },
          {
            "name": "status",
            "expr": "source.status"
          },
          {
            "name": "rejection_code",
            "expr": "source.rejection_code"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "1dfa62fd",
      "displayName": "Page 1",
      "layout": [
        {
          "widget": {
            "name": "kpi_total_claims",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "measure(claim_count)",
                      "expression": "MEASURE(`claim_count`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Total Claims"
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(claim_count)",
                  "format": {
                    "abbreviation": "none",
                    "type": "number-plain"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_approved_amount",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "measure(total_approved_amount)",
                      "expression": "MEASURE(`total_approved_amount`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Total Approved Amount"
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(total_approved_amount)",
                  "format": {
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "places": 1,
                      "type": "max"
                    },
                    "type": "number-plain"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_rejection_rate",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "measure(rejection_rate)",
                      "expression": "MEASURE(`rejection_rate`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Rejection Rate"
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(rejection_rate)",
                  "format": {
                    "decimalPlaces": {
                      "places": 2,
                      "type": "max"
                    },
                    "type": "number-percent"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_avg_turnaround",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "measure(avg_turnaround_days)",
                      "expression": "MEASURE(`avg_turnaround_days`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Avg Turnaround (Days)"
