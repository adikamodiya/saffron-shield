              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(avg_turnaround_days)",
                  "format": {
                    "abbreviation": "none",
                    "decimalPlaces": {
                      "places": 1,
                      "type": "max"
                    },
                    "type": "number-plain"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 9,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "filter_plan",
            "queries": [
              {
                "name": "dashboards/01f1df0b040d161388885252e8f3b7bc/datasets/01f1df0b46c2185d8fb5259d543a2d29_plan_code_at_admission",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "plan_code_at_admission",
                      "expression": "`plan_code_at_admission`"
