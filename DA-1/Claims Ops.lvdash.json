              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "hospital_id",
                  "axis": {
                    "title": "Hospital",
                    "labelAngle": 45
                  },
                  "scale": {
                    "categorySize": {
                      "number": 15,
                      "type": "number-of-categories"
                    },
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
                    }
                  }
                },
                "y": {
                  "fieldName": "measure(claim_count)",
                  "axis": {
                    "title": "Claims"
                  },
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 12,
            "height": 5
