        },
        {
          "widget": {
            "name": "filter_admission_month",
            "queries": [
              {
                "name": "dashboards/01f1df0b040d161388885252e8f3b7bc/datasets/01f1df0b46c2185d8fb5259d543a2d29_admission_month",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "admission_month",
                      "expression": "`admission_month`"
                    },
                    {
                      "name": "admission_month_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "showTitle": true,
                "title": "Admission Month"
              },
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "admission_month",
                    "queryName": "dashboards/01f1df0b040d161388885252e8f3b7bc/datasets/01f1df0b46c2185d8fb5259d543a2d29_admission_month"
                  }
                ]
              }
            }
          },
          "position": {
            "x": 8,
            "y": 2,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "trend_monthly",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "admission_month",
                      "expression": "`admission_month`"
                    },
                    {
                      "name": "measure(claim_count)",
                      "expression": "MEASURE(`claim_count`)"
                    },
                    {
                      "name": "measure(rejected_count)",
                      "expression": "MEASURE(`rejected_count`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Monthly Claims Trend"
              },
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "admission_month",
                  "axis": {
                    "title": "Admission Month"
                  },
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "axis": {
                    "title": "Claims"
                  },
                  "fields": [
                    {
                      "fieldName": "measure(claim_count)",
                      "displayName": "Total Claims"
                    },
                    {
                      "fieldName": "measure(rejected_count)",
                      "displayName": "Rejected Claims"
                    }
                  ],
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 4,
            "width": 8,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "rejection_codes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_ops_metrics",
                  "fields": [
                    {
                      "name": "measure(claim_count)",
                      "expression": "MEASURE(`claim_count`)"
                    },
                    {
                      "name": "rejection_code",
                      "expression": "`rejection_code`"
                    }
                  ],
                  "filters": [
                    {
                      "expression": "`status` IN ('rejected')"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Rejections by Code"
              },
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "measure(claim_count)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "rejection_code",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 4,
            "width": 4,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "hospitals_bar",
